{
  "name": "oa-pdf-downloader",
  "private": true,
  "version": "0.1.0",
  "description": "Electron UI for OA PDF downloader",
  "repository": {
    "type": "git",
    "url": "https://github.com/JiayuDong1/Papers.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development electron .",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "lint": "echo \"(placeholder)\""
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-log": "^5.1.2"
  },
  "build": {
    "appId": "com.jiayudong.oa-pdf-downloader",
    "productName": "OA PDF Downloader",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.venv{,/**}",
          "!dist{,/**}",
          "!__pycache__{,/**}",
          "!*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
